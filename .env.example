# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model used for context summarization and post generation
GEMINI_MODEL=gemini-flash-latest

# Supabase Postgres connection string. Use the "Transaction pooler" URI (port 6543)
# from Supabase Dashboard -> Connect, with your database password filled in.
DATABASE_URL=

# Webhook mode only: shared secret Telegram sends in X-Telegram-Bot-Api-Secret-Token.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
