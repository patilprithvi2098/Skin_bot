# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model used for context summarization and post generation
GEMINI_MODEL=gemini-flash-latest

# Path to the SQLite database file. On Vercel this must be under /tmp (ephemeral).
MEERA_BOT_DB_PATH=meera_bot.db

# Webhook mode only: shared secret Telegram sends in X-Telegram-Bot-Api-Secret-Token.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
